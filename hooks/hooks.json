{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "[ -d docs/atlas/records ] || exit 0; exec python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/store_guard.py\"",
            "timeout": 20
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "[ -d docs/atlas ] && python3 \"${CLAUDE_PLUGIN_ROOT}/skills/using-atlas/scripts/session_start.py\" || true"
          }
        ]
      },
      {
        "matcher": "resume",
        "hooks": [
          {
            "type": "command",
            "command": "[ -d docs/atlas ] && python3 \"${CLAUDE_PLUGIN_ROOT}/skills/using-atlas/scripts/session_start.py\" --resume || true"
          }
        ]
      }
    ]
  }
}
