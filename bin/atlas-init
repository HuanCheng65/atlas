#!/usr/bin/env bash
set -euo pipefail

REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
TARGET="docs/atlas"

# Helper: copy file only if target doesn't exist
copy_if_missing() {
    local src="$1"
    local dst="$2"
    if [ -e "$dst" ]; then
        echo "atlas:   skip $dst (exists)"
    else
        cp "$src" "$dst"
        echo "atlas:   create $dst"
    fi
}

# ---------- 1. atlas data dir ----------
echo "atlas: ensuring $TARGET skeleton"
mkdir -p "$TARGET/records"

copy_if_missing "$REPO_DIR/templates/README.md"  "$TARGET/README.md"
copy_if_missing "$REPO_DIR/templates/ROADMAP.md" "$TARGET/ROADMAP.md"

if [ -z "$(ls -A "$TARGET/records" 2>/dev/null)" ]; then
    touch "$TARGET/records/.gitkeep"
fi

# ---------- 2. CLAUDE.md ----------
ATLAS_SECTION='<!-- atlas-init: BEGIN (managed block; delete entire block + re-run atlas-init to refresh) -->
## Project memory

The project'\''s memory lives at `docs/atlas/`. The SessionStart hook loads its current state into your context; **invoke the `using-atlas` skill** before responding, for the rules on writing to it. Make that call your first action and make it silently — no preamble, no "I'\''ll start by…", no acknowledgement, and no summary of what was loaded. Answer the user'\''s message as though you had simply always known the rest, and refer to this material as the project'\''s memory rather than by the name of the tooling.

Atlas data changes ride the work unit'\''s own commits — never commit `docs/atlas/` updates standalone unless the atlas content is itself the work; commit messages describe the content, not the framework.

See `docs/atlas/README.md` for the data model.
<!-- atlas-init: END -->'

if [ -f CLAUDE.md ]; then
    if grep -qF "atlas-init: BEGIN" CLAUDE.md; then
        echo "atlas: CLAUDE.md already has atlas section, skip"
    else
        printf "\n%s\n" "$ATLAS_SECTION" >> CLAUDE.md
        echo "atlas: appended atlas section to existing CLAUDE.md"
    fi
else
    cat > CLAUDE.md <<'HEAD'
# Agent Rules

## Project context

See PROJECT.md for background and long-term goals.

HEAD
    printf "%s\n\n" "$ATLAS_SECTION" >> CLAUDE.md
    cat >> CLAUDE.md <<'TAIL'
## Coding conventions

(your conventions here)
TAIL
    echo "atlas: created CLAUDE.md"
fi

# ---------- 3. PROJECT.md ----------
if [ -f PROJECT.md ]; then
    echo "atlas: PROJECT.md already exists, skip"
else
    cp "$REPO_DIR"/templates/PROJECT.md PROJECT.md
    echo "atlas: created PROJECT.md from template"
fi

# ---------- 4. next steps ----------
cat <<EOF

atlas-init complete (idempotent — safe to re-run).

Next steps:
  1. Edit $TARGET/ROADMAP.md with current milestones
  2. Fill in PROJECT.md sections (Background / Long-term goals / Glossary / ...)
  3. Try: python3 ~/.claude/skills/atlas-entity/scripts/new.py \\
           --type decision --title "your first decision" --new-tag setup <<'BODY'
     Why this, and what it beat.
BODY
EOF
